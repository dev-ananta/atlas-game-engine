{
  "name": "game-engine-studio",
  "version": "1.0.0",
  "description": "Local-first game engine studio",
  "main": "src/main/index.js",
  "author": "Game Engine Contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "three": "^0.160.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "monaco-editor": "^0.45.0",
    "simple-git": "^3.22.0",
    "uuid": "^9.0.1",
    "@monaco-editor/react": "^4.6.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "@babel/core": "^7.23.7",
    "@babel/preset-react": "^7.23.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.9.0",
    "style-loader": "^3.3.4"
  },
  "build": {
    "appId": "com.gameengine.studio",
    "productName": "GameEngine Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "package.json"
    ],
    "linux": {
      "target": ["AppImage"],
      "category": "Development",
      "icon": "public/icons/icon.png"
    },
    "win": {
      "target": ["nsis"],
      "icon": "public/icons/icon.ico"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "public/icons/icon.icns",
      "category": "public.app-category.developer-tools"
    }
  }
}
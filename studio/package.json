{
  "name": "atlas-game-engine-studio",
  "version": "1.0.0",
  "description": "Atlas Game Engine Studio",
  "main": "src/main/index.js",
  "author": "Game Engine Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dev-ananta/atlas-game-engine.git"
  },
  "scripts": {
    "start": "npm run build:renderer && electron .",
    "dev": "npm run build:renderer && electron . --dev",
    "build:renderer": "webpack --mode production",
    "watch:renderer": "webpack --mode development --watch",
    "build": "electron-builder",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "prebuild": "npm run build:renderer",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "three": "^0.160.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "monaco-editor": "^0.45.0",
    "simple-git": "^3.22.0",
    "uuid": "^11.1.1",
    "@monaco-editor/react": "^4.6.0"
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "@babel/core": "^7.23.7",
    "@babel/preset-react": "^7.23.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.9.0",
    "style-loader": "^3.3.4"
  },
  "build": {
    "appId": "com.atlasgameengine.studio",
    "productName": "Atlas Game Engine Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "package.json"
    ],
    "linux": {
      "target": ["AppImage"],
      "category": "Development"
    },
    "win": {
      "target": ["nsis"]
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.developer-tools"
    }
  }
}
